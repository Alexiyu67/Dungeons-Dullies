{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dullies-and-dungeons.local/schema/dndpack-v1.schema.json",
  "title": "Dullies & Dungeons private pack container manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "containerKind",
    "id",
    "version",
    "locale",
    "createdAt",
    "source",
    "payload",
    "files",
    "privacy",
    "review"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "containerKind": { "enum": ["review-candidates", "installable-content"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "locale": { "enum": ["en", "de"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256", "mediaType"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mediaType", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "mediaType": { "type": "string", "minLength": 1, "maxLength": 100 },
          "size": { "type": "integer", "minimum": 0, "maximum": 16777216 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsPrivateContent", "distributionReady", "networkAccess"],
      "properties": {
        "containsPrivateContent": { "const": true },
        "distributionReady": { "const": false },
        "networkAccess": { "const": false }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "automationEligibleCount"],
      "properties": {
        "status": { "enum": ["needs-review", "reviewed"] },
        "automationEligibleCount": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "containerKind": { "const": "review-candidates" } } },
      "then": {
        "properties": {
          "payload": { "properties": { "primary": { "const": "candidates.json" } } },
          "review": {
            "properties": {
              "status": { "const": "needs-review" },
              "automationEligibleCount": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "containerKind": { "const": "installable-content" } } },
      "then": {
        "properties": {
          "payload": { "properties": { "primary": { "const": "content-manifest.json" } } },
          "review": { "properties": { "status": { "const": "reviewed" } } }
        }
      }
    }
  ]
}
