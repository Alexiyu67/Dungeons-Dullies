{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dulliesanddungeons.app/schema/dndpack-v1.schema.json",
  "title": "Dullies & Dungeons private content archive manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "content"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "const": "content.json" },
        "size": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
