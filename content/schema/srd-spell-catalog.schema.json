{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dullies-and-dungeons.local/schema/srd-spell-catalog.schema.json",
  "title": "Generated SRD class spell catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedBy", "sources", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedBy": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "work",
          "url",
          "sha256",
          "uniqueSpellCount",
          "classSpellCounts"
        ],
        "properties": {
          "revision": { "enum": ["2014-srd-5.1", "2024-srd-5.2.1"] },
          "work": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "uniqueSpellCount": { "type": "integer", "minimum": 1 },
          "classSpellCounts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["bard", "cleric", "druid", "paladin", "ranger", "sorcerer", "warlock", "wizard"],
            "properties": {
              "bard": { "type": "integer", "minimum": 1 },
              "cleric": { "type": "integer", "minimum": 1 },
              "druid": { "type": "integer", "minimum": 1 },
              "paladin": { "type": "integer", "minimum": 1 },
              "ranger": { "type": "integer", "minimum": 1 },
              "sorcerer": { "type": "integer", "minimum": 1 },
              "warlock": { "type": "integer", "minimum": 1 },
              "wizard": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "level",
          "classes",
          "school",
          "concentration",
          "ritual",
          "specificMaterial",
          "aliases",
          "en",
          "de",
          "castPreviews"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^spell\\.[a-z0-9][a-z0-9.-]+$" },
          "revision": { "enum": ["2014-srd-5.1", "2024-srd-5.2.1"] },
          "level": { "type": "integer", "minimum": 0, "maximum": 9 },
          "classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["BARD", "CLERIC", "DRUID", "PALADIN", "RANGER", "SORCERER", "WARLOCK", "WIZARD"] }
          },
          "school": {
            "enum": [
              "Abjuration",
              "Conjuration",
              "Divination",
              "Enchantment",
              "Evocation",
              "Illusion",
              "Necromancy",
              "Transmutation"
            ]
          },
          "concentration": { "type": "boolean" },
          "ritual": { "type": "boolean" },
          "specificMaterial": { "type": "boolean" },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "en": { "$ref": "#/$defs/text" },
          "de": { "$ref": "#/$defs/text" },
          "castPreviews": {
            "type": "array",
            "items": { "$ref": "#/$defs/castPreview" }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "castPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotLevel", "en", "de"],
      "properties": {
        "slotLevel": { "type": "integer", "minimum": 1, "maximum": 9 },
        "en": { "type": "string", "minLength": 1 },
        "de": { "type": "string", "minLength": 1 }
      }
    }
  }
}
